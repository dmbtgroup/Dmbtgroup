{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/favicon.ico", "destination": "/assets/dmbt-icon.png", "permanent": false },
    {
      "source": "/:path((?!assets/|index\\.html$|robots\\.txt$).+)",
      "destination": "https://tactime.dmbtgroup.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
