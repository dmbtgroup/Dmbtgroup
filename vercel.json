{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.dmbtgroup.com"
        }
      ],
      "destination": "https://dmbtgroup.com/$1",
      "permanent": true
    },
    {
      "source": "/royal",
      "destination": "https://artraland.com/",
      "permanent": false
    },
    {
      "source": "/royal/:path*",
      "destination": "https://artraland.com/:path*",
      "permanent": false
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/dmbt-icon.png",
      "permanent": false
    },
    {
      "source": "/:path((?!assets/|index\\.html$|robots\\.txt$|experts(?:\\.html)?$).+)",
      "destination": "https://tactime.dmbtgroup.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "cleanUrls": true
}
